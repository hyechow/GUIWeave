[
  {
    "label": "terminal empty list with notice and tabs",
    "group": "empty",
    "at_boundary": true,
    "fields": ["content"],
    "frames": [
      [
        {"type": "notice", "content": "private-notice", "texts": ["Your saved posts are only visible to you."]},
        {"type": "tabs", "content": "favorites-bookmarks", "texts": ["Favorites", "Bookmarks"], "controls": ["Favorites", "Bookmarks"]}
      ],
      [
        {"type": "notice", "content": "private-notice", "texts": ["Your saved posts are only visible to you."]},
        {"type": "tabs", "content": "favorites-bookmarks", "texts": ["Favorites", "Bookmarks"], "controls": ["Favorites", "Bookmarks"]}
      ]
    ],
    "expected": {"rows": []}
  },
  {
    "label": "one terminal record is not empty",
    "group": "single_record",
    "at_boundary": true,
    "fields": ["author_handle", "content"],
    "frames": [
      [
        {"type": "author", "content": "author-1", "texts": ["@one"]},
        {"type": "body", "content": "body-1", "texts": ["Only visible record"]},
        {"type": "actions", "content": "actions-1", "texts": ["Reply", "Favorite"], "controls": ["Reply", "Favorite"]}
      ]
    ],
    "expected": {
      "rows": [{"author_handle": "@one", "content": "Only visible record"}]
    }
  },
  {
    "label": "multi-cell feed split across scrolling windows",
    "group": "feed",
    "at_boundary": true,
    "fields": ["author_handle", "content"],
    "frames": [
      [
        {"type": "banner", "content": "feed-title", "texts": ["Recent posts"]},
        {"type": "author", "content": "author-1", "texts": ["@one"]},
        {"type": "body", "content": "body-1", "texts": ["First post"]},
        {"type": "actions", "content": "actions-1", "texts": ["Reply", "Favorite"], "controls": ["Reply", "Favorite"]}
      ],
      [
        {"type": "body", "content": "body-1", "texts": ["First post"]},
        {"type": "actions", "content": "actions-1", "texts": ["Reply", "Favorite"], "controls": ["Reply", "Favorite"]},
        {"type": "author", "content": "author-2", "texts": ["@two"]},
        {"type": "body", "content": "body-2", "texts": ["Second post"]}
      ],
      [
        {"type": "author", "content": "author-2", "texts": ["@two"]},
        {"type": "body", "content": "body-2", "texts": ["Second post"]},
        {"type": "actions", "content": "actions-2", "texts": ["Reply", "Favorite"], "controls": ["Reply", "Favorite"]}
      ]
    ],
    "expected": {
      "rows": [
        {"author_handle": "@one", "content": "First post"},
        {"author_handle": "@two", "content": "Second post"}
      ]
    }
  },
  {
    "label": "homogeneous list rows",
    "group": "list",
    "at_boundary": true,
    "fields": ["name"],
    "frames": [
      [
        {"type": "row", "content": "row-1", "texts": ["Alpha"]},
        {"type": "row", "content": "row-2", "texts": ["Beta"]},
        {"type": "row", "content": "row-3", "texts": ["Gamma"]}
      ]
    ],
    "expected": {
      "rows": [{"name": "Alpha"}, {"name": "Beta"}, {"name": "Gamma"}]
    }
  }
]

