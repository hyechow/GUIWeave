  {
    "task_name": "MastodonConditionalFavoTask",
    "group": "conditional_collection_write",
    "apps": [
      "Mastodon"
    ],
    "intent": "favorite all toots tagged “#dogs” on Mastodon, but do not add them to my favorite list if they are already in my favorite list or bookmark list.",
    "contract": {
      "method_counts": {
        "commit": 1
      },
      "required_calls": [
        {
          "method": "commit",
          "target_mode": "present",
          "inside_loop": true,
          "values_include": {
            "favorited": true
          }
        }
      ],
      "ordered_call_alternatives": [
        [
          {
            "method": "query",
            "entity": "SavedFavorites"
          },
          {
            "method": "acquire",
            "fields_include": [
              "author_handle",
              "content"
            ]
          },
          {
            "method": "query",
            "entity": "SavedBookmarks"
          },
          {
            "method": "acquire",
            "fields_include": [
              "author_handle",
              "content"
            ]
          },
          {
            "method": "query",
            "entity": "TaggedToots",
            "filter_keys_exact": [
              "tag"
            ],
            "filters_include": {
              "tag": "#dogs"
            }
          },
          {
            "method": "acquire",
            "fields_include": [
              "author_handle",
              "content"
            ]
          },
          {
            "method": "reach",
            "target_mode": "present",
            "inside_loop": true,
            "success_include": {
              "entity": "TootDetail"
            }
          },
          {
            "method": "commit",
            "target_mode": "present",
            "inside_loop": true
          }
        ],
        [
          {
            "method": "query",
            "entity": "TaggedToots",
            "filter_keys_exact": [
              "tag"
            ],
            "filters_include": {
              "tag": "#dogs"
            }
          },
          {
            "method": "acquire",
            "fields_include": [
              "author_handle",
              "content"
            ]
          },
          {
            "method": "query",
            "entity": "SavedFavorites"
          },
          {
            "method": "acquire",
            "fields_include": [
              "author_handle",
              "content"
            ]
          },
          {
            "method": "query",
            "entity": "SavedBookmarks"
          },
          {
            "method": "acquire",
            "fields_include": [
              "author_handle",
              "content"
            ]
          },
          {
            "method": "reach",
            "target_mode": "present",
            "inside_loop": true,
            "success_include": {
              "entity": "TootDetail",
              "tag": "#dogs"
            }
          },
          {
            "method": "commit",
            "target_mode": "present",
            "inside_loop": true
          }
        ]
      ],
      "literal_values": [
        "#dogs",
        "SavedFavorites",
        "SavedBookmarks"
      ]
    }
