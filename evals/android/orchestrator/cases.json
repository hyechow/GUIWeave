  {
    "task_name": "ScheduleLunchViaSmsTask",
    "group": "cross_app_source_write",
    "apps": [
      "Calendar",
      "Messages"
    ],
    "use_raw_intent": true,
    "intent": "I've received a lunch invitation via text message; please reply \"OK\" and schedule a corresponding event on my calendar.",
    "contract": {
      "method_counts": {
        "commit": 2
      },
      "method_min_counts": {
        "command": 1,
        "reach": 2,
        "query": 1,
        "read": 1,
        "acquire": 1
      },
      "required_calls": [
        {
          "method": "reach",
          "success_include": {
            "entity": "Messages"
          }
        },
        {
          "method": "read",
          "target_mode": "present",
          "fields_include": [
            "body"
          ]
        },
        {
          "method": "reach",
          "target_mode": "present",
          "success_include": {
            "entity": "Message"
          }
        }
      ],
      "ordered_calls": [
        {
          "method": "query",
          "entity": "Messages",
          "filter_keys_exact": [
            "body"
          ]
        },
        {
          "method": "acquire",
          "fields_include": [
            "id"
          ]
        },
        {
          "method": "commit",
          "target_mode": "present",
          "values_include": {
            "reply": "OK"
          }
        },
        {
          "method": "commit",
          "target_mode": "none",
          "value_keys_include": [
            "start_ts",
            "end_ts"
          ]
        }
      ],
      "features": [
        "no_return_value",
        "verifies_semantic_match",
        "read_data_flows_to_commit_goal"
      ],
      "forbidden_features": [
        "asserts_exactly_one"
      ],
      "literal_values": [
        "Calendar",
        "Messages",
        "OK"
      ]
    }
  },
