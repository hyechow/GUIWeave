#!/usr/bin/env bash
# 用 vendored 的独立 scrcpy + adb 镜像 Android 设备(不依赖 brew)。
#
# 用法:
#   bin/scrcpy                          # 镜像 $ANDROID_SERIAL 或唯一连接的设备(默认 320 宽小窗)
#   bin/scrcpy 192.168.31.240:5555      # 先 adb connect 该无线设备再镜像
#   bin/scrcpy --off                    # 息屏镜像(--turn-screen-off --stay-awake)
#   bin/scrcpy --width=420              # 自定义窗口宽度(高度按设备比例自动算)
#   bin/scrcpy 192.168.31.240:5555 --off --width=320 --max-size 1280
#                                       # 无线 + 息屏 + 自定义宽 + 透传任意 scrcpy 参数
#
# 第一个形如 host:port 的参数当作无线 serial 取走(USB 设备用 ANDROID_SERIAL=<序列号>)。
# --off 展开成 --turn-screen-off --stay-awake。
# 后台启动,不占用终端(立即返回;输出落 $TMPDIR/scrcpy-<serial>.log,关镜像窗口或 kill pid 即退)。
# 窗口宽默认 320(像 iPhone 那样的小窗),可用 --width=N 或 SCRCPY_WIDTH=N 覆盖;
# 若你显式传了 --window-width/--window-height/-m/--max-size,则尊重你的、不再注入默认宽。
# 其余参数原样透传给 scrcpy。
set -e
cd "$(dirname "$0")/.."

# 优先使用显式配置；Apple Silicon 可使用插件和旧 vendor 中的 arm64 资产；
# Intel Mac 跳过这些资产并回退 PATH 中的本机兼容版本。
APPLE_SILICON=0
if [ "$(uname -m)" = "arm64" ] \
  || [ "$(sysctl -n hw.optional.arm64 2>/dev/null || true)" = "1" ]; then
  APPLE_SILICON=1
fi
if [ -x "${GUIWEAVE_SCRCPY_PATH:-}" ]; then
  SCRCPY="$GUIWEAVE_SCRCPY_PATH"
  ADB="${GUIWEAVE_ADB_PATH:-$(dirname "$SCRCPY")/adb}"
elif [ "$APPLE_SILICON" = "1" ] \
  && [ -x "plugins/guiweave-automation/assets/android-arm64/scrcpy-macos-aarch64-v4.0/scrcpy" ]; then
  SCRCPY="plugins/guiweave-automation/assets/android-arm64/scrcpy-macos-aarch64-v4.0/scrcpy"
  ADB="${GUIWEAVE_ADB_PATH:-plugins/guiweave-automation/assets/android-arm64/scrcpy-macos-aarch64-v4.0/adb}"
fi
if [ -z "${SCRCPY:-}" ] && [ "$APPLE_SILICON" = "1" ]; then
  SCRCPY_DIR=$(ls -d vendor/scrcpy-macos-*/ 2>/dev/null | head -1 || true)
fi
if [ -z "${SCRCPY:-}" ] && [ -n "${SCRCPY_DIR:-}" ]; then
  SCRCPY="${SCRCPY_DIR%/}/scrcpy"
  ADB="${SCRCPY_DIR%/}/adb"
fi
if [ -z "${SCRCPY:-}" ] && command -v scrcpy >/dev/null 2>&1; then
  SCRCPY=$(command -v scrcpy)
  ADB="${GUIWEAVE_ADB_PATH:-$(command -v adb || echo adb)}"
fi
if [ -z "${SCRCPY:-}" ]; then
  echo "✗ 找不到 scrcpy：插件资产、vendor/scrcpy-macos-*/ 和 PATH 均不可用。" >&2
  if [ "$APPLE_SILICON" != "1" ]; then
    echo "  插件内 scrcpy 是 arm64 版本，Intel Mac 需要 PATH 中的兼容版本。" >&2
  fi
  echo "  解法：重新安装完整插件，或 brew install scrcpy。" >&2
  exit 1
fi
if [ ! -x "$ADB" ]; then
  echo "✗ 找不到可执行 adb：$ADB" >&2
  exit 1
fi
export ADB                       # scrcpy 经 $ADB 找 adb
export ADBUTILS_ADB_PATH="$ADB"  # 顺带让本仓库的 adbutils 用同一个 adb

# serial:默认取环境变量;第一个形如 host:port 的参数覆盖之并取走。
SERIAL="${ANDROID_SERIAL:-}"
if [ -n "$1" ] && [[ "$1" == *:* ]]; then
  SERIAL="$1"; shift
fi

# 展开 --off / --width,其余透传;记录用户是否已显式给尺寸 flag。
WIDTH="${SCRCPY_WIDTH:-320}"
HAS_SIZE=0
ARGS=()
for a in "$@"; do
  case "$a" in
    --off)        ARGS+=(--turn-screen-off --stay-awake) ;;
    --width=*)    WIDTH="${a#--width=}" ;;
    --window-width|--window-width=*|--window-height|--window-height=*|--max-size|--max-size=*|-m|-m*)
                  HAS_SIZE=1; ARGS+=("$a") ;;
    *)            ARGS+=("$a") ;;
  esac
done
# 用户未显式指定尺寸 → 注入默认小窗宽(高度由设备比例自动算)。WIDTH=0 可禁用默认。
if [ "$HAS_SIZE" = 0 ] && [ -n "$WIDTH" ] && [ "$WIDTH" != "0" ]; then
  ARGS+=(--window-width="$WIDTH")
fi

# 无线设备(host:port)先确保 adb 已连。
if [ -n "$SERIAL" ] && [[ "$SERIAL" == *:* ]]; then
  "$ADB" connect "$SERIAL" >/dev/null 2>&1 || true
fi

SEL=()
[ -n "$SERIAL" ] && SEL=(-s "$SERIAL")

# 后台启动,不占用终端;输出落日志,scrcpy 脱离终端继续跑(关镜像窗口即退)。
_safe="${SERIAL//[:.]/_}"
LOG="${TMPDIR:-/tmp}/scrcpy-${_safe:-auto}.log"
nohup "$SCRCPY" "${SEL[@]}" "${ARGS[@]}" >"$LOG" 2>&1 &
PID=$!
disown 2>/dev/null || true
echo "scrcpy 已后台启动: ${SERIAL:-<auto>}  (pid $PID, scrcpy=$SCRCPY, adb=$ADB)"
echo "  日志: $LOG   (关镜像窗口即退,或 kill $PID)"
