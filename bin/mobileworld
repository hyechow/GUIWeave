#!/usr/bin/env bash
# 跑一条 MobileWorld 任务(Android agent;动作走 adb,任务生命周期+评分走 MobileWorld HTTP 后端)。
# 用法: bin/mobileworld [--headless] <task-name> [额外参数...]
#       bin/mobileworld --list                       # 列出 GUI-only 任务名
#   例: bin/mobileworld <task-name>                  # 跑一条任务(默认带状态 HUD)
#       bin/mobileworld --headless <task-name>       # 全后台(无 HUD/光标覆盖)
#       bin/mobileworld <task-name> --max-turns 30   # 透传给 mobileworld.py
#       bin/mobileworld <task-name> --no-orchestrator
# 前置(MobileWorld Docker 宿主上,容器端口需对本机可达):
#   1) emulator adb: 容器 5556 经 adb relay + portproxy 暴露 → `adb connect <host>:5556`
#   2) backend HTTP: 容器 6800 经 portproxy 暴露 → MW_BASE_URL=http://<host>:6800
# 覆盖: MW_BASE_URL=<url> MW_ADB_SERIAL=<host:port> bin/mobileworld <task-name>
#   默认 MW_BASE_URL=http://192.168.31.57:6800  MW_ADB_SERIAL=192.168.31.57:5556
# 外网: snapshot 会清空 Android 系统代理；本机 MobileWorld 容器内 proxy_chain 默认
#       暴露给模拟器为 10.0.2.2:38888，可用 MW_ANDROID_HTTP_PROXY=off 关闭。
# 稳定性: 若 /task/init 后 emulator/adb 未恢复，默认重启 MobileWorld 容器内 emulator 并重试一次；
#       可用 MW_EMULATOR_RESTART_CMD=off 关闭，或覆盖为其它启动命令。
set -e
cd "$(dirname "$0")/.."
export PATH="$HOME/.local/bin:$PATH"

headless=0
args=()
for arg in "$@"; do
  if [[ "$arg" == "--headless" ]]; then
    headless=1
  else
    args+=("$arg")
  fi
done
set -- "${args[@]}"

if [[ "$headless" == "1" ]]; then
  headless_arg=(--headless)
else
  headless_arg=()
fi

# headless 是唯一可见性开关:headed 模式默认显示状态 HUD + 光标覆盖,--headless 则全关。
# "$@" 在后,额外参数可覆盖默认。AGENT_MODEL 默认 qwen35(与 bin/runner 一致)。
exec env AGENT_PLATFORM="android" \
         AGENT_MODE="${AGENT_MODE:-daemon}" \
         AGENT_MODEL="${AGENT_MODEL:-qwen35}" \
         MW_ANDROID_HTTP_PROXY="${MW_ANDROID_HTTP_PROXY:-10.0.2.2:38888}" \
         MW_EMULATOR_RESTART_CMD="${MW_EMULATOR_RESTART_CMD:-docker exec mobile_world_env_0 bash /app/docker/start_emulator.sh}" \
         uv run python -m gui_agent.adapters.android.mobileworld \
         "${headless_arg[@]}" "$@"
