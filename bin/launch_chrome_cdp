#!/usr/bin/env bash
# 为 browser adapter 启动一个带远程调试(CDP)的 Chrome,供 Playwright connect_over_cdp 接管。
#
# 为什么要独立 profile + 这几个 flag:
#   --user-data-dir                          默认 profile 拒绝 --remote-debugging-port,CDP 必须用非默认数据目录
#   --disable-backgrounding-occluded-windows
#   --disable-features=CalculateNativeWinOcclusion
#                                            窗口被终端遮住时仍持续出帧 → 截图保持快、agent 无需 bring_to_front
#                                            (保持非抢占)。否则遮挡窗口会停止合成,截图变慢甚至卡。
#
# 用法:
#   bin/launch_chrome_cdp                 # 端口 9222,profile ~/chrome-cdp-profile
#   PORT=9333 bin/launch_chrome_cdp       # 自定义端口(agent 侧记得 export CHROME_CDP_URL=http://localhost:9333)
#   CHROME_BIN=/path/to/Chrome bin/launch_chrome_cdp  # 显式覆盖自动发现
#
# 启动后在弹出的 Chrome 窗口里登录/打开目标页,再到另一个终端跑:
#   AGENT_PLATFORM=browser uv run python -m gui_agent.core.runner "你的指令" --auto-continue
set -euo pipefail

PORT="${PORT:-9222}"
PROFILE="${PROFILE:-$HOME/chrome-cdp-profile}"

# 显式 CHROME_BIN 优先；否则发现系统 Chrome，再回退到任意已安装的 Playwright Chromium。
# 不固定 Playwright revision：`uv sync` / Playwright 升级会清掉旧 revision 目录。
if [[ -z "${CHROME_BIN:-}" ]]; then
  for candidate in \
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
    "/Applications/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing" \
    "/Applications/Chromium.app/Contents/MacOS/Chromium" \
    "$HOME/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
    "$HOME/Applications/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing" \
    "$HOME/Applications/Chromium.app/Contents/MacOS/Chromium"
  do
    if [[ -x "$candidate" ]]; then
      CHROME_BIN="$candidate"
      break
    fi
  done
fi

if [[ -z "${CHROME_BIN:-}" ]]; then
  for candidate in \
    "$HOME"/Library/Caches/ms-playwright/chromium-*/chrome-mac*/Google\ Chrome\ for\ Testing.app/Contents/MacOS/Google\ Chrome\ for\ Testing
  do
    if [[ -x "$candidate" ]]; then
      CHROME_BIN="$candidate"
    fi
  done
fi

if [[ -z "${CHROME_BIN:-}" || ! -x "$CHROME_BIN" ]]; then
  echo "找不到可执行的 Chrome${CHROME_BIN:+：$CHROME_BIN}" >&2
  echo "请安装 Google Chrome / Playwright Chromium，或用 CHROME_BIN=/path/to/chrome 指定。" >&2
  exit 1
fi

echo "Chrome: $CHROME_BIN"

# Prepare the optional native cursor before a run. Compilation is deliberately
# kept here, outside the action dispatch path; failure only disables visualization.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ "$(uname -s)" == "Darwin" ]]; then
  if ! "$SCRIPT_DIR/build_agent_cursor"; then
    echo "警告: agent_cursor 构建失败，本次仍会启动 Chrome，但不显示动作光标。" >&2
  fi
fi

# 该端口已经有一个调试 Chrome → 直接复用,不重复拉起。
if curl -s --max-time 1 "http://localhost:$PORT/json/version" >/dev/null 2>&1; then
  echo "已有调试 Chrome 监听 :$PORT,直接复用。"
  echo "  AGENT_PLATFORM=browser CHROME_CDP_URL=http://localhost:$PORT uv run python -m gui_agent.core.runner \"...\" --auto-continue"
  exit 0
fi

mkdir -p "$PROFILE"
echo "启动 Chrome(CDP :$PORT,profile $PROFILE)..."
# 后台启动 + nohup 脱离终端 HUP;Chrome 留在前台窗口供你操作,终端释放出来。
nohup "$CHROME_BIN" \
  --remote-debugging-port="$PORT" \
  --user-data-dir="$PROFILE" \
  --disable-backgrounding-occluded-windows \
  --disable-features=CalculateNativeWinOcclusion \
  --no-first-run \
  --no-default-browser-check \
  --disable-infobars \
  >/dev/null 2>&1 &
PID=$!

# 等 CDP 端点就绪(最多 ~9s),确认起来了再返回。
for _ in $(seq 1 30); do
  if curl -s --max-time 1 "http://localhost:$PORT/json/version" >/dev/null 2>&1; then
    echo "Chrome CDP 就绪 :$PORT (pid $PID)"
    echo "  停止:kill $PID"
    if [[ "$PORT" != "9222" ]]; then
      echo "  agent 侧需 export CHROME_CDP_URL=http://localhost:$PORT"
    fi
    exit 0
  fi
  sleep 0.3
done

echo "Chrome 在超时内未暴露 CDP :$PORT(pid $PID),请检查。" >&2
exit 1
