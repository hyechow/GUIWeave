#!/usr/bin/env bash
# 给 Android 设备发一个导航键(三大金刚键 + 菜单),经 vendored adb。
#
# 用法:
#   bin/android-key back|home|menu|recents
#   bin/android-key 返回|主屏|菜单|最近
#   ANDROID_SERIAL=192.168.31.240:5555 bin/android-key home   # 指定设备(无线/USB)
#   bin/android-key home 192.168.31.240:5555                  # 设备也可作第二参数
#
# 设备解析:第二参数 > $ANDROID_SERIAL > 唯一连接的设备(自动选)。无线 host:port 会先 adb connect。
set -e
cd "$(dirname "$0")/.."

# 定位 vendored adb,找不到回退 PATH。
ADB="vendor/scrcpy-macos-aarch64-v4.0/adb"
[ -x "$ADB" ] || ADB="$(command -v adb || true)"
[ -n "$ADB" ] || { echo "✗ 找不到 adb(vendor/ 无,PATH 也无)" >&2; exit 1; }
export ADBUTILS_ADB_PATH="$ADB"

case "${1:-}" in
  back|返回)               code=4 ;;    # KEYCODE_BACK   系统返回上一级
  home|主屏|主屏幕)         code=3 ;;    # KEYCODE_HOME   回主屏
  menu|菜单)               code=82 ;;   # KEYCODE_MENU   菜单键(部分应用响应)
  app_switch|recents|最近|最近任务|多任务|appswitch)
                           code=187 ;;  # KEYCODE_APP_SWITCH  App 切换器/最近任务/多任务(现代三键的第三键)
  *)
    echo "用法: bin/android-key <back|home|menu|recents>  (也支持 返回|主屏|菜单|最近)" >&2
    exit 1 ;;
esac

SERIAL="${2:-${ANDROID_SERIAL:-}}"
SEL=()
if [ -n "$SERIAL" ]; then
  if [[ "$SERIAL" == *:* ]]; then
    "$ADB" connect "$SERIAL" >/dev/null 2>&1 || true
  fi
  SEL=(-s "$SERIAL")
fi

"$ADB" "${SEL[@]}" shell input keyevent "$code"
echo "✓ ${1} (keyevent $code) -> ${SERIAL:-<auto>}"
