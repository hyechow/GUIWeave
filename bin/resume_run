#!/usr/bin/env bash
# Fork a failed headed-browser run into a new derived run.
# Derived logs: logs/gui_agent/webarena/browser/resume/<timestamp>/
# Usage: bin/resume_run logs/gui_agent/webarena/browser/<run> [--max-turns 25]
set -e
cd "$(dirname "$0")/.."

run_dir="${1:-}"
if [[ -z "$run_dir" ]]; then
  echo "用法: bin/resume_run <run-log-dir> [--max-turns 25] [额外参数...]" >&2
  exit 1
fi
shift

if [[ ! -f "$run_dir/context.json" ]]; then
  echo "续跑 context 不存在: $run_dir/context.json" >&2
  exit 1
fi

exec uv run python -m gui_agent.adapters.browser.webarena \
  --resume-log-dir "$run_dir" "$@"
