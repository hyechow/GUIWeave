# Benchmark archives: each suite has reports/<task>.html (SELF-CONTAINED, screenshots
# inlined as base64 via `python -m gui_agent.reports.inline` — committed) and runs/<task>/
# (full run logs: raw screenshots + context.json + logs — local-only, regenerable from logs/).
benchmark/*/runs/
