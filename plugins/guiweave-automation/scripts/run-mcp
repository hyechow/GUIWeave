#!/usr/bin/env bash
# Launch the repo-backed MCP server from a GUIWeave source checkout.
set -euo pipefail

PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ASSET_ROOT="$PLUGIN_ROOT/assets"

# Prefer executables shipped inside the installed plugin cache. Explicit user
# overrides still win, and the runtime retains its repository/PATH fallbacks.
ANDROID_ASSET_DIR="$ASSET_ROOT/android-arm64/scrcpy-macos-aarch64-v4.0"
if [[ -x "$ANDROID_ASSET_DIR/adb" && -z "${GUIWEAVE_ADB_PATH:-}" ]]; then
  export GUIWEAVE_ADB_PATH="$ANDROID_ASSET_DIR/adb"
fi
if [[ -x "${GUIWEAVE_ADB_PATH:-}" && -z "${ADBUTILS_ADB_PATH:-}" ]]; then
  export ADBUTILS_ADB_PATH="$GUIWEAVE_ADB_PATH"
fi

APPLE_SILICON=0
if [[ "$(uname -m)" == "arm64" ]] \
  || [[ "$(sysctl -n hw.optional.arm64 2>/dev/null || true)" == "1" ]]; then
  APPLE_SILICON=1
fi
if [[ "$APPLE_SILICON" == "1" \
  && -x "$ANDROID_ASSET_DIR/scrcpy" \
  && -z "${GUIWEAVE_SCRCPY_PATH:-}" ]]; then
  export GUIWEAVE_SCRCPY_PATH="$ANDROID_ASSET_DIR/scrcpy"
fi

IPHONE_ASSET_DIR="$ASSET_ROOT/iphone-arm64"
if [[ "$APPLE_SILICON" == "1" ]]; then
  if [[ -x "$IPHONE_ASSET_DIR/sck_server" \
    && -z "${GUIWEAVE_SCK_SERVER:-}" ]]; then
    export GUIWEAVE_SCK_SERVER="$IPHONE_ASSET_DIR/sck_server"
  fi
  if [[ -x "$IPHONE_ASSET_DIR/mirror_daemon" \
    && -z "${GUIWEAVE_MIRROR_DAEMON:-}" ]]; then
    export GUIWEAVE_MIRROR_DAEMON="$IPHONE_ASSET_DIR/mirror_daemon"
  fi
fi

is_guiweave_root() {
  [[ -f "$1/pyproject.toml" && -d "$1/gui_agent" ]]
}

find_checkout_parent() {
  local candidate="$1"
  while [[ "$candidate" != "/" ]]; do
    if is_guiweave_root "$candidate"; then
      printf '%s\n' "$candidate"
      return 0
    fi
    candidate="$(dirname "$candidate")"
  done
  return 1
}

find_local_marketplace_checkout() {
  local config_home="${CODEX_HOME:-$HOME/.codex}"
  local config_file="$config_home/config.toml"
  [[ -f "$config_file" ]] || return 1
  local candidate
  while IFS= read -r candidate; do
    if is_guiweave_root "$candidate" \
      && grep -q '"name"[[:space:]]*:[[:space:]]*"guiweave-automation"' \
        "$candidate/.agents/plugins/marketplace.json" 2>/dev/null; then
      (cd "$candidate" && pwd)
      return 0
    fi
  done < <(
    awk '
      function emit() {
        if (in_marketplace && source_type == "local" && source != "") print source
      }
      /^\[marketplaces\./ {
        emit()
        in_marketplace = 1
        source_type = ""
        source = ""
        next
      }
      /^\[/ {
        emit()
        in_marketplace = 0
        next
      }
      in_marketplace && /^[[:space:]]*source_type[[:space:]]*=/ {
        value = $0
        sub(/^[^=]*=[[:space:]]*/, "", value)
        gsub(/^"|"$/, "", value)
        source_type = value
      }
      in_marketplace && /^[[:space:]]*source[[:space:]]*=/ {
        value = $0
        sub(/^[^=]*=[[:space:]]*/, "", value)
        gsub(/^"|"$/, "", value)
        source = value
      }
      END { emit() }
    ' "$config_file"
  )
  return 1
}

REPO_ROOT=""
if [[ -n "${GUIWEAVE_REPO_ROOT:-}" ]] && is_guiweave_root "$GUIWEAVE_REPO_ROOT"; then
  REPO_ROOT="$(cd "$GUIWEAVE_REPO_ROOT" && pwd)"
elif repo_candidate="$(find_checkout_parent "$PLUGIN_ROOT" 2>/dev/null)"; then
  REPO_ROOT="$repo_candidate"
elif repo_candidate="$(find_checkout_parent "$PWD" 2>/dev/null)"; then
  REPO_ROOT="$repo_candidate"
elif repo_candidate="$(find_local_marketplace_checkout 2>/dev/null)"; then
  REPO_ROOT="$repo_candidate"
fi

if [[ -z "$REPO_ROOT" ]]; then
  echo "GUIWeave runtime not found next to the plugin." >&2
  echo "Install from a complete local GUIWeave clone or set GUIWEAVE_REPO_ROOT." >&2
  exit 1
fi

cd "$REPO_ROOT"
exec uv run --project "$REPO_ROOT" guiweave-mcp
