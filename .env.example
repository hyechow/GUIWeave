# GUIWeave model gateway (recommended: OpenAI-compatible private gateway)
# Copy this file to .env, replace the placeholder values, then restart the
# Run Console or Codex so the local MCP process reloads the environment.
AGENT_CONFIG=config.standard.yaml
STANDARD_BASE_URL=https://gateway.example.com/v1
STANDARD_API_KEY=replace-me

# Optional request controls.
CHAT_TIMEOUT_S=60
CHAT_MAX_RETRIES=2

# Alternative: Alibaba Cloud MaaS Token Plan. If selected, comment out the
# STANDARD entries above and use the matching config/provider variables.
# AGENT_CONFIG=config.tokenplan.yaml
# TOKENPLAN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# TOKENPLAN_API_KEY=replace-me

# Headed Browser defaults to an existing Chrome CDP session.
# CHROME_CDP_URL=http://127.0.0.1:9222

# Android device serial, for example emulator-5554 or 192.168.1.20:5555.
# ANDROID_SERIAL=emulator-5554
